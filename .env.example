APP_NAME=ContractIQ Document Validator
APP_ENV=development
APP_ENV=development
LOG_LEVEL=INFO
CLASSIFICATION_REVIEW_THRESHOLD=0.70
# Send every document through Azure OpenAI as an independent classification
# verifier. Any deterministic/LLM disagreement is routed to the adjuster.
LLM_ALWAYS_VERIFY_DOCUMENTS=true
ESTIMATE_INVOICE_VARIANCE_THRESHOLD=0.20
MAX_UPLOAD_SIZE_BYTES=10485760
POLICY_REFERENCE_PATH=policy_reference/icici_lombard_private_car_package_policy_wording.pdf
# Comma-separated browser origins permitted to call this API locally.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Local: a localhost connection is correct. Production: do not package .env;
# inject DATABASE_URL as an Azure Key Vault reference or set
# DATABASE_URL_SECRET_NAME + AZURE_KEY_VAULT_URL for managed-identity lookup.
DATABASE_URL=postgresql+psycopg://contractiq_user:replace-me@localhost:5432/contractiq
# Local-account pilot authentication. Keep false during existing-demo
# transition. Before enabling true, generate a long random LOCAL_AUTH_SECRET.
AUTH_REQUIRED=false
LOCAL_AUTH_SECRET=
LOCAL_AUTH_TOKEN_MINUTES=480
# Never enable this outside a controlled pilot; validators should normally be provisioned by an admin.
LOCAL_AUTH_ALLOW_VALIDATOR_REGISTRATION=false
AZURE_KEY_VAULT_URL=
DATABASE_URL_SECRET_NAME=
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_ACCOUNT_URL=
AZURE_STORAGE_CONTAINER=claim-documents
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
AZURE_DOCUMENT_INTELLIGENCE_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_KEY_SECRET_NAME=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21
# Optional self-hosted Arize Phoenix observability. Keep disabled until an
# internal Phoenix endpoint, data-retention policy, and access controls exist.
# Metadata only: ContractIQ never exports document bytes, OCR text, prompts,
# model responses, credentials, Blob URLs, or claimant identifiers.
PHOENIX_ENABLED=false
PHOENIX_ENDPOINT=http://127.0.0.1:6006/v1/traces
PHOENIX_PROJECT_NAME=contractiq
PHOENIX_SERVICE_NAME=contractiq-backend
PHOENIX_CAPTURE_CONTENT=false
