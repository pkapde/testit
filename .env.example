APP_NAME=ContractIQ Document Validator
APP_ENV=development
LOG_LEVEL=INFO
CLASSIFICATION_REVIEW_THRESHOLD=0.70
ESTIMATE_INVOICE_VARIANCE_THRESHOLD=0.20
MAX_UPLOAD_SIZE_BYTES=10485760
# Comma-separated browser origins permitted to call this API locally.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DATABASE_URL=postgresql+psycopg://contractiq_user:replace-me@localhost:5432/contractiq
AZURE_KEY_VAULT_URL=
DATABASE_URL_SECRET_NAME=
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_ACCOUNT_URL=
AZURE_STORAGE_CONTAINER=claim-documents
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
AZURE_DOCUMENT_INTELLIGENCE_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_KEY_SECRET_NAME=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21
GEMINI_MODEL=gemini-3.6-flash
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=contractiq
LANGSMITH_API_KEY_SECRET_NAME=
